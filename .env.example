# ---- Qdrant Cloud (free tier) ----
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=msmarco_xi

# ---- Groq ----
# NOTE: llama-3.1-8b-instant was shut down 2026-08-16. See decision.md D-09.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
MAX_TOKENS=1024

# ---- Models (FastEmbed / ONNX) ----
DENSE_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SPARSE_MODEL=Qdrant/bm25
RERANK_MODEL=jinaai/jina-reranker-v2-base-multilingual

# ---- Corpus sizing ----
ROWS_PER_LANG=200
RETRIEVE_CANDIDATES=20
TOP_K=5
SARVAM_API_KEY=your-sarvam-api-key   # Day 2: Indic STT/TTS
